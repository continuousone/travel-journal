# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/travel-journal
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/travel-journal?retryWrites=true&w=majority
MONGODB_URI=

# Secret required in an `x-admin-key` header to create, edit or delete entries.
# Leave blank to make the API read-only.
ADMIN_KEY=

# Port for the Express server (Render sets this automatically)
PORT=3001
